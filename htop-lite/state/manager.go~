// Package state provides the central state manager for htop-lite.
// It merges snapshots from all collectors into a single SystemState,
// handles user input events (sort, filter, kill, scroll), and broadcasts
// fresh snapshots to the renderer after every update.
package state

import (
	"context"
	"log"
	"sort"
	"strings"

	"htop-lite/collector"
	"htop-lite/events"
)

// SortField enumerates the columns by which the process list can be sorted.
type SortField int

const (
	SortByCPU  SortField = iota // default — most active processes first
	SortByMem
	SortByPID
	SortByName
)

// String returns a human-readable label used by the renderer for the
// column header highlight.
func (s SortField) String() string {
	switch s {
	case SortByCPU:
		return "CPU%"
	case SortByMem:
		return "MEM%"
	case SortByPID:
		return "PID"
	case SortByName:
		return "NAME"
	default:
		return "CPU%"
	}
}

// SystemState is the single source of truth for everything the renderer
// needs to draw one frame. It is rebuilt from scratch on every update
// rather than mutated in place, so the renderer always receives a
// consistent, fully-populated snapshot with no partial reads.
type SystemState struct {
	CPU       collector.CPUSnapshot
	Memory    collector.MemSnapshot
	Processes []collector.ProcessInfo // sorted + filtered, ready to display
	Network   collector.NetworkSnapshot

	// UI state — carried in the snapshot so the renderer is stateless.
	SortBy      SortField
	FilterQuery string
	ScrollOffset int // index of the first visible process row
	Selected     int // index within the visible (filtered) list
}

// Manager owns the mutable system state and is the only goroutine
// allowed to write to it. All other goroutines communicate with it
// exclusively through channels, eliminating the need for mutexes.
type Manager struct {
	current SystemState

	// raw holds the unfiltered, unsorted process list as received from
	// the collector. We keep this so we can re-sort/re-filter without
	// waiting for the next collector tick.
	rawProcesses []collector.ProcessInfo
}

// NewManager constructs a Manager with sensible defaults.
func NewManager() *Manager {
	return &Manager{
		current: SystemState{
			SortBy: SortByCPU,
		},
	}
}

// Run is the manager's main loop. It selects across all incoming channels
// and updates state accordingly, then pushes a fresh SystemState snapshot
// to the renderer via stateCh.
//
// It exits cleanly when ctx is cancelled.
func (m *Manager) Run(
	ctx context.Context,
	cpuCh <-chan collector.CPUSnapshot,
	memCh <-chan collector.MemSnapshot,
	procCh <-chan []collector.ProcessInfo,
	netCh <-chan collector.NetworkSnapshot,
	inputCh <-chan events.InputEvent,
	stateCh chan SystemState,
) {
	log.Println("stateManager: started")

	for {
		select {
		case <-ctx.Done():
			log.Println("stateManager: context cancelled, exiting")
			return

		// ------------------------------------------------------------------
		// Collector updates — merge latest snapshot and re-broadcast.
		// ------------------------------------------------------------------

		case snap := <-cpuCh:
			m.current.CPU = snap
			m.broadcast(stateCh)

		case snap := <-memCh:
			m.current.Memory = snap
			m.broadcast(stateCh)

		case procs := <-procCh:
			m.rawProcesses = procs
			m.applyFilter()
			m.applySort()
			m.clampScroll()
			m.broadcast(stateCh)

		case snap := <-netCh:
			m.current.Network = snap
			m.broadcast(stateCh)

		// ------------------------------------------------------------------
		// Input events — mutate UI state, then re-broadcast.
		// ------------------------------------------------------------------

		case event := <-inputCh:
			m.handleInput(event, ctx)
			m.broadcast(stateCh)
		}
	}
}

// handleInput translates an InputEvent into a state mutation.
// It is called exclusively from Run's select loop, so no locking is needed.
func (m *Manager) handleInput(event events.InputEvent, ctx context.Context) {
	switch event.Type {

	case events.EventScrollUp:
		if m.current.Selected > 0 {
			m.current.Selected--
		}
		// Scroll the window up if the cursor moves above the visible area.
		if m.current.Selected < m.current.ScrollOffset {
			m.current.ScrollOffset--
		}

	case events.EventScrollDown:
		maxIdx := len(m.current.Processes) - 1
		if m.current.Selected < maxIdx {
			m.current.Selected++
		}
		// Scroll the window down if the cursor moves below the visible area.
		// The renderer tells us how many rows are visible via the event payload.
		visibleRows := event.Payload.(int)
		if m.current.Selected >= m.current.ScrollOffset+visibleRows {
			m.current.ScrollOffset++
		}

	case events.EventCycleSort:
		// Advance to the next sort field, wrapping around.
		m.current.SortBy = SortField((int(m.current.SortBy) + 1) % 4)
		m.current.Selected = 0
		m.current.ScrollOffset = 0
		m.applySort()

	case events.EventFilter:
		// Payload carries the current filter string as typed by the user.
		query, ok := event.Payload.(string)
		if !ok {
			query = ""
		}
		m.current.FilterQuery = query
		m.current.Selected = 0
		m.current.ScrollOffset = 0
		m.applyFilter()
		m.applySort()
		m.clampScroll()

	case events.EventKill:
		m.killSelected()

	case events.EventQuit:
		// The input handler already called cancel(); nothing to do here
		// except log it. The context cancellation will unblock Run's select.
		log.Println("stateManager: quit event received")
	}
}

// applyFilter rebuilds current.Processes from rawProcesses using the
// current FilterQuery. An empty query passes all processes through.
func (m *Manager) applyFilter() {
	query := strings.ToLower(strings.TrimSpace(m.current.FilterQuery))
	if query == "" {
		// No filter — copy the full list.
		m.current.Processes = make([]collector.ProcessInfo, len(m.rawProcesses))
		copy(m.current.Processes, m.rawProcesses)
		return
	}

	filtered := m.current.Processes[:0] // reuse backing array, reset length
	for _, p := range m.rawProcesses {
		if strings.Contains(strings.ToLower(p.Name), query) {
			filtered = append(filtered, p)
		}
	}
	m.current.Processes = filtered
}

// applySort sorts current.Processes in-place according to current.SortBy.
// Sorting is always descending for numeric fields (highest usage first)
// and ascending for PID and Name.
func (m *Manager) applySort() {
	procs := m.current.Processes
	switch m.current.SortBy {
	case SortByCPU:
		sort.Slice(procs, func(i, j int) bool {
			return procs[i].CPUPercent > procs[j].CPUPercent
		})
	case SortByMem:
		sort.Slice(procs, func(i, j int) bool {
			return procs[i].MemPercent > procs[j].MemPercent
		})
	case SortByPID:
		sort.Slice(procs, func(i, j int) bool {
			return procs[i].PID < procs[j].PID
		})
	case SortByName:
		sort.Slice(procs, func(i, j int) bool {
			return strings.ToLower(procs[i].Name) < strings.ToLower(procs[j].Name)
		})
	}
}

// clampScroll ensures ScrollOffset and Selected stay within valid bounds
// after a filter or process-list update shrinks the visible list.
func (m *Manager) clampScroll() {
	total := len(m.current.Processes)
	if total == 0 {
		m.current.Selected = 0
		m.current.ScrollOffset = 0
		return
	}

	// Keep Selected within list bounds.
	if m.current.Selected >= total {
		m.current.Selected = total - 1
	}

	// Keep ScrollOffset so that Selected is always visible.
	if m.current.ScrollOffset > m.current.Selected {
		m.current.ScrollOffset = m.current.Selected
	}
}

// killSelected sends SIGTERM to the currently selected process.
// It logs the outcome but does not modify state directly — the process
// collector will notice the process is gone on its next tick and update
// the list naturally.
func (m *Manager) killSelected() {
	procs := m.current.Processes
	if len(procs) == 0 {
		return
	}
	idx := m.current.Selected
	if idx < 0 || idx >= len(procs) {
		return
	}

	target := procs[idx]
	log.Printf("stateManager: sending SIGTERM to PID %d (%s)", target.PID, target.Name)

	if err := target.Kill(); err != nil {
		log.Printf("stateManager: kill PID %d failed: %v", target.PID, err)
	} else {
		log.Printf("stateManager: killed PID %d (%s)", target.PID, target.Name)
	}
}

// broadcast pushes a copy of the current state to stateCh.
// If the renderer hasn't consumed the previous snapshot yet, the stale
// one is drained first so the renderer always gets the freshest frame.
func (m *Manager) broadcast(stateCh chan SystemState) {
	snap := m.current // shallow copy — slices are safe; renderer doesn't mutate them

	select {
	case stateCh <- snap:
	default:
		// Drain stale snapshot, then send fresh one.
		select {
		case <-stateCh:
		default:
		}
		select {
		case stateCh <- snap:
		default:
			log.Println("stateManager: dropped state broadcast, renderer still busy")
		}
	}
}
