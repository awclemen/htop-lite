package main

import (
	"context"
	"log"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

	"htop-lite/collector"
	"htop-lite/events"
	"htop-lite/state"
	"htop-lite/ui"
)

// tickRate controls how often collectors sample system metrics.
// 1 second is a sensible default — responsive but not wasteful.
const tickRate = time.Second

func main() {
	// -------------------------------------------------------------------------
	// Logging setup
	// Direct logs to a file so they don't corrupt the terminal UI.
	// -------------------------------------------------------------------------
	logFile, err := os.OpenFile("htop-lite.log", os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)
	if err != nil {
		log.Fatalf("failed to open log file: %v", err)
	}
	defer logFile.Close()
	log.SetOutput(logFile)
	log.Println("htop-lite starting...")

	// -------------------------------------------------------------------------
	// Context + signal handling
	// A single root context is cancelled when the user presses q or Ctrl+C.
	// Every goroutine receives this context and exits cleanly when it's done.
	// -------------------------------------------------------------------------
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()

	// Listen for OS interrupt signals (Ctrl+C, SIGTERM).
	sigCh := make(chan os.Signal, 1)
	signal.Notify(sigCh, syscall.SIGINT, syscall.SIGTERM)
	go func() {
		sig := <-sigCh
		log.Printf("received signal: %v — shutting down", sig)
		cancel()
	}()

	// -------------------------------------------------------------------------
	// Channels
	// Each collector sends its snapshot type on its own dedicated channel.
	// Buffered with size 1 so a slow renderer never blocks a collector.
	// -------------------------------------------------------------------------
	cpuCh  := make(chan collector.CPUSnapshot, 1)
	memCh  := make(chan collector.MemSnapshot, 1)
	procCh := make(chan []collector.ProcessInfo, 1)
	netCh  := make(chan collector.NetworkSnapshot, 1)

	// inputCh carries keyboard events from the UI input handler to the
	// state manager, which decides how to act on them.
	inputCh := make(chan events.InputEvent, 5)

	// stateCh carries fully-merged SystemState snapshots from the state
	// manager to the renderer. Size 1 — renderer always gets the latest.
	stateCh := make(chan state.SystemState, 1)

	// -------------------------------------------------------------------------
	// WaitGroup
	// Used to wait for all goroutines to finish before main() exits.
	// -------------------------------------------------------------------------
	var wg sync.WaitGroup

	// -------------------------------------------------------------------------
	// Collectors
	// Each collector runs in its own goroutine, polling on tickRate.
	// They are pure producers — they write to their channel and nothing else.
	// -------------------------------------------------------------------------
	wg.Add(1)
	go func() {
		defer wg.Done()
		collector.RunCPU(ctx, cpuCh, tickRate)
		log.Println("cpuCollector stopped")
	}()

	wg.Add(1)
	go func() {
		defer wg.Done()
		collector.RunMemory(ctx, memCh, tickRate)
		log.Println("memCollector stopped")
	}()

	wg.Add(1)
	go func() {
		defer wg.Done()
		collector.RunProcesses(ctx, procCh, tickRate)
		log.Println("processCollector stopped")
	}()

	wg.Add(1)
	go func() {
		defer wg.Done()
		collector.RunNetwork(ctx, netCh, tickRate)
		log.Println("networkCollector stopped")
	}()

	// -------------------------------------------------------------------------
	// State Manager
	// Merges incoming collector snapshots into a single SystemState struct.
	// Also handles InputEvents (sort, filter, kill) from the input handler.
	// Broadcasts the merged state to the renderer after every update.
	// -------------------------------------------------------------------------
	wg.Add(1)
	go func() {
		defer wg.Done()
		mgr := state.NewManager()
		mgr.Run(ctx, cpuCh, memCh, procCh, netCh, inputCh, stateCh)
		log.Println("stateManager stopped")
	}()

	// -------------------------------------------------------------------------
	// Input Handler
	// Reads raw keypresses from stdin and translates them into InputEvents.
	// Runs concurrently with the renderer — both touch the terminal, but
	// input.Run() only reads while renderer.Run() only writes.
	// -------------------------------------------------------------------------
	wg.Add(1)
	go func() {
		defer wg.Done()
		handler := ui.NewInputHandler(inputCh, cancel) // cancel lets 'q' quit
		handler.Run(ctx)
		log.Println("inputHandler stopped")
	}()

	// -------------------------------------------------------------------------
	// Renderer
	// Receives SystemState snapshots and redraws the terminal UI.
	// This is the only goroutine that writes to stdout.
	// -------------------------------------------------------------------------
	wg.Add(1)
	go func() {
		defer wg.Done()
		r := ui.NewRenderer()
		if err := r.Init(); err != nil {
			log.Fatalf("renderer init failed: %v", err)
		}
		defer r.Cleanup() // restore terminal state on exit
		r.Run(ctx, stateCh)
		log.Println("renderer stopped")
	}()

	// -------------------------------------------------------------------------
	// Shutdown
	// Block until context is cancelled (q key, Ctrl+C, or SIGTERM), then
	// wait for every goroutine to finish before exiting. This ensures the
	// terminal is always restored to a sane state even on unexpected exits.
	// -------------------------------------------------------------------------
	<-ctx.Done()
	log.Println("context cancelled — waiting for goroutines to finish...")
	wg.Wait()
	log.Println("htop-lite exited cleanly")
}
